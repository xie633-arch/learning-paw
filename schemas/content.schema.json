{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xie633-arch.github.io/learning-paw/schemas/content.schema.json",
  "title": "Learning OS Content Schema v1",
  "description": "Aligned with Obsidian 10_Data_Schema/01_Content_Schema_v1.md. Concept and Card are separate objects.",
  "oneOf": [
    { "$ref": "#/$defs/Concept" },
    { "$ref": "#/$defs/Card" },
    { "$ref": "#/$defs/Source" }
  ],
  "$defs": {
    "Concept": {
      "type": "object",
      "required": ["schema_version", "concept_id", "domain", "type", "title", "level", "status", "source_id"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "concept_id": { "type": "string", "minLength": 1 },
        "domain": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "level": { "type": ["string", "number"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["active", "draft", "deprecated"] },
        "source_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "Card": {
      "type": "object",
      "required": ["schema_version", "card_id", "concept_id", "domain", "practice_type", "skill", "prompt", "answer", "difficulty", "source_id", "status"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "card_id": { "type": "string", "minLength": 1 },
        "concept_id": { "type": "string", "minLength": 1 },
        "domain": { "type": "string" },
        "practice_type": {
          "type": "string",
          "enum": ["recognition", "active_recall", "production", "listening", "listening_dictation", "reading", "cloze", "sentence_building", "error_correction", "pronunciation_shadowing", "pronunciation_reading", "conversation", "writing", "case_analysis", "visual_identification"]
        },
        "skill": { "type": "string" },
        "prompt": { "type": "string" },
        "answer": { "type": ["string", "array", "object"] },
        "explanation": { "type": ["string", "null"] },
        "difficulty": { "type": ["number", "string"] },
        "estimated_seconds": { "type": ["number", "null"], "minimum": 0 },
        "source_id": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "draft", "deprecated"] },
        "license": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "Source": {
      "type": "object",
      "required": ["schema_version", "source_id", "source_type", "source_name", "license", "usage_scope"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "source_id": { "type": "string" },
        "source_type": { "type": "string", "enum": ["official", "open_dataset", "textbook_reference", "self_authored", "ai_generated", "unknown", "public_research"] },
        "source_name": { "type": "string" },
        "source_url": { "type": ["string", "null"] },
        "license": { "type": "string" },
        "usage_scope": { "type": "string" },
        "verified_at": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  }
}
