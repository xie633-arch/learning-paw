{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xie633-arch.github.io/learning-paw/schemas/content.schema.json",
  "title": "Learning OS Content Schema v1",
  "type": "object",
  "required": ["id", "concept_id", "domain", "type", "skill", "level", "question", "answer", "source", "license"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "concept_id": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "enum": ["phone", "korean", "retail", "industry"] },
    "deck": { "type": "string" },
    "category": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["active_recall", "scenario_recall", "visual_recall", "visual_reasoning", "listening", "evidence_reasoning"]
    },
    "skill": { "type": "string", "minLength": 1 },
    "level": { "type": "integer", "minimum": 1, "maximum": 5 },
    "question": { "type": "string", "minLength": 1 },
    "answer": { "type": "string", "minLength": 1 },
    "image": { "type": ["string", "null"] },
    "audioText": { "type": ["string", "null"] },
    "tts": { "type": ["string", "null"] },
    "source": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": ["string", "null"] },
        "as_of": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "license": { "type": "string" }
  },
  "additionalProperties": true
}
