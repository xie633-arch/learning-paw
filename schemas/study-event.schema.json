{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xie633-arch.github.io/learning-paw/schemas/study-event.schema.json",
  "title": "Learning OS StudyEvent Schema v1",
  "description": "Aligned with Obsidian 10_Data_Schema/03_StudyEvent_Schema_v1.md. StudyEvent is the immutable learning fact source.",
  "type": "object",
  "required": ["schema_version", "event_id", "occurred_at", "domain", "event_type", "result", "source"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "event_id": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string" },
    "domain": { "type": "string" },
    "event_type": {
      "type": "string",
      "enum": ["lesson_started", "lesson_completed", "practice_attempt", "review_rating", "listening_attempt", "pronunciation_attempt", "conversation_session", "writing_submission", "assessment_attempt", "assessment_completed", "error_created", "error_resolved", "curriculum_status_changed", "manual_note"]
    },
    "content_id": { "type": ["string", "null"] },
    "concept_id": { "type": ["string", "null"] },
    "skill": { "type": ["string", "null"] },
    "result": {
      "type": "object",
      "properties": {
        "rating": { "type": ["string", "null"], "enum": ["good", "hard", "again", null] },
        "correct": { "type": ["boolean", "null"] },
        "score": { "type": ["number", "null"] },
        "max_score": { "type": ["number", "null"] },
        "confidence": { "type": ["number", "string", "null"] }
      },
      "additionalProperties": true
    },
    "duration_ms": { "type": ["number", "null"], "minimum": 0 },
    "session_id": { "type": ["string", "null"] },
    "source": { "type": "string" },
    "device_id": { "type": ["string", "null"] },
    "algorithm": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
