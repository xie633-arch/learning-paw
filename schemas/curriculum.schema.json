{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xie633-arch.github.io/learning-paw/schemas/curriculum.schema.json",
  "title": "Learning OS Curriculum Schema v1",
  "type": "object",
  "required": ["title", "steps"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "title": { "type": "string" },
    "source": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "task", "output", "order", "objective", "prerequisite"],
        "properties": {
          "schema_version": { "const": "1.0" },
          "id": { "type": "string" },
          "order": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "objective": { "type": "string" },
          "keyPoints": { "type": "array", "items": { "type": "string" } },
          "task": { "type": "string" },
          "output": { "type": "string" },
          "prerequisite": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
